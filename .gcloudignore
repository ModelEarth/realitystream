# Files uploaded by "gcloud run deploy --source ." from deploy/deploy-cloud-run.sh.
# Only the service is uploaded: api/, parameters/, and the files buildpacks read
# (requirements.txt, Procfile, .python-version). Everything else is ignored.
/*
!/api/
!/parameters/
!/requirements.txt
!/Procfile
!/.python-version
api/__pycache__/
# Random Bits Forest binary, downloaded by deploy/deploy-cloud-run.sh
!/models/
/models/*
!/models/random-bits-forest/
/models/random-bits-forest/*
!/models/random-bits-forest/rbf/
